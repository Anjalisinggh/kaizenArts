<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_champagne"
    tools:context=".activites.DetailedActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/detailed_img"
            android:layout_width="match_parent"
            android:layout_height="420dp"
            android:background="@drawable/bg_placeholder_teal"
            android:scaleType="centerCrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/detailed_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:navigationIcon="@drawable/ic_back_ink"
            app:titleTextColor="@android:color/transparent" />

        <FrameLayout
            android:id="@+id/detailed_wishlist_btn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="60dp"
            android:background="@drawable/bg_icon_chip"
            app:layout_constraintEnd_toStartOf="@id/detailed_cart_btn"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/detailed_wishlist_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_nav_wishlist_outline"
                app:tint="@color/color_ivory" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/detailed_cart_btn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_icon_chip"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_bag_outline"
                app:tint="@color/color_ivory" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/detail_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/color_champagne"
            android:orientation="vertical"
            android:padding="22dp"
            app:layout_constraintTop_toBottomOf="@id/detailed_img">

            <TextView
                android:id="@+id/detailed_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/playfair_display_variable"
                android:text="Product Name"
                android:textColor="@color/color_espresso"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <RatingBar
                    android:id="@+id/my_rating"
                    style="?android:attr/ratingBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:isIndicator="true"
                    android:numStars="5"
                    android:progressTint="@color/color_gold"
                    android:stepSize="0.1" />

                <TextView
                    android:id="@+id/rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/inter_variable"
                    android:text="4.0"
                    android:textColor="@color/color_warm_gray"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/detailed_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/playfair_display_variable"
                android:text="0"
                android:textColor="@color/color_gold_deep"
                android:textSize="21sp" />

            <TextView
                android:id="@+id/detailed_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/inter_variable"
                android:lineSpacingExtra="4dp"
                android:text="Description"
                android:textColor="@color/color_warm_gray"
                android:textSize="12.5sp" />

            <!-- Try-On promo -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:fontFamily="@font/playfair_display_variable"
                android:textStyle="italic"
                android:gravity="center"
                android:text="Not sure how it'll look?"
                android:textColor="@color/color_warm_gray"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/try_on_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_btn_outline_gold"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="15dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="9dp"
                    android:src="@drawable/ic_nav_try_on"
                    app:tint="@color/color_gold_deep" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_variable"
                    android:letterSpacing="0.06"
                    android:text="TRY IT ON"
                    android:textAllCaps="false"
                    android:textColor="@color/color_gold_deep"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/remove_item"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:padding="4dp"
                    android:background="@drawable/bg_btn_outline_ink"
                    android:src="@drawable/iconminus" />

                <TextView
                    android:id="@+id/quantity"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:fontFamily="@font/inter_variable"
                    android:text="1"
                    android:textColor="@color/color_espresso"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/add_item"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:padding="4dp"
                    android:background="@drawable/bg_btn_outline_ink"
                    android:src="@drawable/plusicon" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/add_to_cart"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@color/color_espresso"
                    android:padding="14dp"
                    android:text="Add to Cart"
                    android:textAllCaps="false"
                    android:textColor="@color/color_ivory"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/buy_now"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_outline_ink"
                    android:padding="14dp"
                    android:text="Buy Now"
                    android:textAllCaps="false"
                    android:textColor="@color/color_espresso"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
