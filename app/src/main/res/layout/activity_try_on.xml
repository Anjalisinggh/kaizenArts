<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_espresso">

    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.example.kaizenarts.tryon.EarringOverlayView
        android:id="@+id/earring_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Face guide oval, visible only until a face is found -->
    <View
        android:id="@+id/face_guide"
        android:layout_width="236dp"
        android:layout_height="296dp"
        android:layout_gravity="center"
        android:layout_marginTop="-30dp"
        android:background="@drawable/bg_face_guide" />

    <!-- Camera / storage permission prompt -->
    <LinearLayout
        android:id="@+id/permission_prompt"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_espresso"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/playfair_display_variable"
            android:textStyle="italic"
            android:gravity="center"
            android:text="Kaizen Arts needs camera access to try earrings on"
            android:textColor="@color/color_champagne"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/grant_permission_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_btn_gold"
            android:fontFamily="@font/inter_variable"
            android:paddingStart="22dp"
            android:paddingTop="12dp"
            android:paddingEnd="22dp"
            android:paddingBottom="12dp"
            android:text="ALLOW CAMERA"
            android:textColor="@color/color_espresso"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp">

        <FrameLayout
            android:id="@+id/try_on_close"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_icon_chip"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/playfair_display_variable"
            android:gravity="center"
            android:letterSpacing="0.1"
            android:text="TRY IT ON"
            android:textColor="@color/color_champagne"
            android:textSize="14sp" />

        <FrameLayout
            android:id="@+id/try_on_info"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_icon_chip"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_bag_outline" />
        </FrameLayout>
    </LinearLayout>

    <!-- Status pill -->
    <TextView
        android:id="@+id/try_on_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="78dp"
        android:background="@drawable/bg_icon_chip_pill"
        android:fontFamily="@font/inter_variable"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:text="Position your face inside the frame"
        android:textColor="@color/color_champagne"
        android:textSize="11sp" />

    <!-- Product chip -->
    <LinearLayout
        android:id="@+id/try_on_product_chip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="204dp"
        android:background="@drawable/bg_product_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <View
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_placeholder_brown" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/try_on_product_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/playfair_display_variable"
                android:text="Noor Chandbali Drops"
                android:textColor="@color/color_champagne"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/try_on_product_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_variable"
                android:text="₹ 11,200"
                android:textColor="@color/color_gold"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/try_on_add_to_bag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_outline_gold"
            android:fontFamily="@font/inter_variable"
            android:letterSpacing="0.05"
            android:paddingStart="10dp"
            android:paddingTop="7dp"
            android:paddingEnd="10dp"
            android:paddingBottom="7dp"
            android:text="ADD TO BAG"
            android:textColor="@color/color_gold"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Earring carousel -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/earring_carousel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="120dp"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingStart="22dp"
        android:paddingEnd="22dp" />

    <!-- Bottom controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="26dp"
        android:gravity="center"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/try_on_flip"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="44dp"
            android:background="@drawable/bg_icon_chip"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_camera_flip" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/try_on_capture"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:background="@drawable/bg_shutter_ring"
            android:clickable="true"
            android:focusable="true">

            <View
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_shutter_dot" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="44dp"
            android:background="@drawable/bg_icon_chip">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_nav_try_on" />
        </FrameLayout>
    </LinearLayout>

</FrameLayout>
