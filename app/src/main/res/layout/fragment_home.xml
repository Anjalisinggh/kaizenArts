<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_ivory"
    tools:context=".fragments.HomeFragment">

    <LinearLayout
        android:id="@+id/home_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_ivory"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <!-- Header: wordmark + search / account / cart -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/aguafina_script"
                android:text="@string/app_name"
                android:textColor="@color/color_espresso"
                android:textSize="24sp" />

            <ImageView
                android:id="@+id/home_search_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_search"
                app:tint="@color/color_espresso" />

            <ImageView
                android:id="@+id/home_account_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_nav_profile"
                app:tint="@color/color_espresso" />

            <ImageView
                android:id="@+id/home_bag_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_bag_outline"
                app:tint="@color/color_espresso" />
        </LinearLayout>

        <!-- Editorial hero -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="460dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_hero_editorial">

            <ImageView
                android:layout_width="150dp"
                android:layout_height="250dp"
                android:layout_gravity="center|top"
                android:layout_marginTop="40dp"
                android:alpha="0.9"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_earring_chandbali"
                app:tint="@color/color_gold_light" />

            <View
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_hero_scrim" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_variable"
                    android:letterSpacing="0.22"
                    android:text="THE EVERYDAY EDIT"
                    android:textColor="@color/color_gold_light"
                    android:textSize="9.5sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/playfair_display_variable"
                    android:lineSpacingExtra="2dp"
                    android:text="Jewelry that feels\nlike you."
                    android:textColor="@color/color_ivory"
                    android:textSize="30sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/inter_variable"
                    android:text="Discover pieces made to complete your everyday."
                    android:textColor="#C7BFB6"
                    android:textSize="12.5sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/home_shop_collection"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_ivory"
                        android:fontFamily="@font/inter_variable"
                        android:gravity="center"
                        android:letterSpacing="0.08"
                        android:padding="13dp"
                        android:text="SHOP COLLECTION"
                        android:textColor="@color/color_espresso"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/home_try_it_on"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_outline_gold"
                        android:fontFamily="@font/inter_variable"
                        android:gravity="center"
                        android:letterSpacing="0.08"
                        android:padding="13dp"
                        android:text="TRY IT ON"
                        android:textColor="@color/color_gold_light"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Category Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="20dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/playfair_display_variable"
                android:text="Shop by Style"
                android:textSize="20sp"
                android:textColor="@color/color_espresso" />

            <TextView
                android:id="@+id/category_see_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:fontFamily="@font/inter_variable"
                android:letterSpacing="0.06"
                android:text="SEE ALL"
                android:textColor="@color/color_warm_gray"
                android:textSize="10sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rec_category"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="14dp"
            android:clipToPadding="false"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <!-- New Products Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/new_product_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/playfair_display_variable"
                    android:text="New Arrivals"
                    android:textSize="20sp"
                    android:textColor="@color/color_espresso" />

                <TextView
                    android:id="@+id/newProducts_see_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:fontFamily="@font/inter_variable"
                    android:letterSpacing="0.06"
                    android:text="SEE ALL"
                    android:textColor="@color/color_warm_gray"
                    android:textSize="10sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/new_product_rec"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clipToPadding="false"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />
        </LinearLayout>

        <!-- Popular Products Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/popular_products"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/playfair_display_variable"
                    android:textStyle="italic"
                    android:text="Your kind of sparkle"
                    android:textColor="@color/color_espresso"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/popular_see_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:fontFamily="@font/inter_variable"
                    android:letterSpacing="0.06"
                    android:text="SEE ALL"
                    android:textColor="@color/color_warm_gray"
                    android:textSize="10sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/popular_rec"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:nestedScrollingEnabled="false"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
