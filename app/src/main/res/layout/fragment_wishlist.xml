<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/onboard_mist">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/amethysta"
            android:text="Your Wishlist"
            android:textColor="@color/onboard_ink"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/wishlist_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:fontFamily="@font/poppins"
            android:text="0 pieces saved"
            android:textColor="@color/onboard_ink_soft"
            android:textSize="11.5sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/wishlist_rec"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="96dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/wishlist_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_nav_wishlist_outline"
            android:tint="@color/onboard_ink_soft" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/amethysta"
            android:textStyle="italic"
            android:text="Nothing saved yet"
            android:textColor="@color/onboard_ink"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/poppins"
            android:gravity="center"
            android:text="Tap the heart on any piece to keep it here."
            android:textColor="@color/onboard_ink_soft"
            android:textSize="11.5sp" />
    </LinearLayout>
</FrameLayout>
