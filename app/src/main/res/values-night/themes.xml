<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Kaizen Arts keeps its ivory editorial look regardless of system theme;
         screens create their own dark moments (hero, AR try-on) deliberately. -->
    <style name="Base.Theme.KaizenArts" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/color_espresso</item>
        <item name="colorPrimaryDark">@color/color_espresso</item>
        <item name="colorOnPrimary">@color/color_ivory</item>

        <item name="colorSecondary">@color/color_gold</item>
        <item name="colorSecondaryVariant">@color/color_gold_deep</item>
        <item name="colorOnSecondary">@color/color_espresso</item>
        <item name="colorAccent">@color/color_gold</item>

        <item name="android:statusBarColor">@color/color_ivory</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/color_champagne</item>
        <item name="android:windowBackground">@color/color_ivory</item>

        <item name="actionBarStyle">@style/AppBarStyle</item>
    </style>

    <style name="Theme.KaizenArts" parent="Base.Theme.KaizenArts" />

    <style name="AppBarStyle" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:background">@color/color_ivory</item>
        <item name="titleTextColor">@color/color_espresso</item>
        <item name="subtitleTextColor">@color/color_warm_gray</item>
    </style>

</resources>
