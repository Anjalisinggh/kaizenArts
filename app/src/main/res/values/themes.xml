<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Base.Theme.KaizenArts" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary Colors -->
        <item name="colorPrimary">@color/onboard_ink</item>
        <item name="colorPrimaryDark">@color/onboard_ink</item>
        <item name="colorOnPrimary">@color/onboard_cream</item>

        <!-- Secondary / accent -->
        <item name="colorSecondary">@color/onboard_gold</item>
        <item name="colorSecondaryVariant">@color/atelier_gold_deep</item>
        <item name="colorOnSecondary">@color/onboard_ink</item>
        <item name="colorAccent">@color/onboard_gold</item>

        <item name="android:statusBarColor">@color/onboard_mist</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/onboard_cream</item>
        <item name="android:windowBackground">@color/onboard_mist</item>

        <!-- App Bar Styling -->
        <item name="actionBarStyle">@style/AppBarStyle</item>
    </style>

    <!-- Main Theme -->
    <style name="Theme.KaizenArts" parent="Base.Theme.KaizenArts" />

    <!-- App Bar Styling -->
    <style name="AppBarStyle" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:background">@color/onboard_mist</item>
        <item name="titleTextColor">@color/onboard_ink</item>
        <item name="subtitleTextColor">@color/onboard_ink_soft</item>
    </style>

</resources>
